# Copy to .env next to compose.yaml. Only DB_PASSWORD is required:
# everything else is set in Debrief (Settings) once it's running.
DB_PASSWORD=change-me        # openssl rand -hex 16

# Optional overlays (see the comments at the top of each file):
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml:compose.nas.yaml
# DEBRIEF_HOST=debrief.example.com       # compose.traefik.yaml
# AUDIO_PATH=/mnt/meetings/audio         # compose.nas.yaml
# EXPORTS_PATH=/mnt/meetings/exports
# MEETINGS_UID=99
# MEETINGS_GID=100

# Ports, without Traefik
# WEB_PORT=3000
# MCP_PORT=3001

# Pin a build instead of :latest
# DEBRIEF_TAG=0.1.42

# Any setting from the app can also go here (it then wins and is locked in
# Settings), e.g. ANTHROPIC_API_KEY=… or TZ=America/New_York. AUTH_MODE=none
# turns sign-in off, for when a proxy in front already guards Debrief.
