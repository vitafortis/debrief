# Copy to .env next to compose.yaml.

# Required
DB_PASSWORD=change-me
AUTH_SECRET=            # openssl rand -base64 32
DEBRIEF_HOST=debrief.armgrp.dev
# Without Traefik (compose.standalone.yaml): uncomment both; see README, step 4.
# COMPOSE_FILE=compose.yaml:compose.standalone.yaml
# DEBRIEF_URL=http://192.168.1.20:3000
TZ=America/New_York

# Sign-in: Authentik (OpenID Connect)…
AUTH_OIDC_ISSUER=       # e.g. https://auth.armgrp.dev/application/o/debrief/
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
ALLOWED_EMAILS=         # optional, comma-separated
# …or a single password instead
DEBRIEF_PASSWORD=
OWNER_NAME=Nathan

# Calendars (or add them in Settings). context:calendar-id, comma-separated.
# Put the Google credentials JSON (service account key or OAuth authorized_user) at ./secrets/google-creds.json.
GOOGLE_CALENDARS=ironclad:you@ironclad.example,pwnbook:primary
ICS_CALENDARS=

# Storage on the NAS: full recordings (kept, so meetings can be replayed and re-transcribed)
# and the notes, transcripts and summaries written for each meeting.
AUDIO_PATH=/mnt/meetings/audio
EXPORTS_PATH=/mnt/meetings/exports

# Transcription
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
HF_TOKEN=               # for speaker labels; accept pyannote/speaker-diarization-community-1's terms first
MEETINGS_UID=1000
MEETINGS_GID=1000

# Where tasks go
AKIFLOW_WEBHOOK_URL=    # an IFTTT / Zapier / Make webhook that creates the Akiflow task
LINEAR_API_KEY=
LINEAR_TEAM=            # a team key, e.g. ENG
LINEAR_TEAMS=           # per context, e.g. ironclad:ENG,pwnbook:PWN

# Claude: summarizes each new meeting and pulls out its action items (AUTO_EXTRACT=false
# to only do it from the button). Without a key, ask Claude through the MCP server instead.
ANTHROPIC_API_KEY=
AUTO_EXTRACT=true

# Slack: the summary and action items once a meeting is summarized. An incoming webhook URL,
# or one per context: ironclad:https://hooks.slack.com/…,pwnbook:https://hooks.slack.com/…
SLACK_WEBHOOK_URL=
SLACK_WEBHOOKS=

# Optional: a fixed bearer token for Claude, besides the API keys made in Settings
MCP_TOKEN=
